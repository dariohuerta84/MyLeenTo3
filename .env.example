# ==============================================================================
# MyLeenTo3 — Variables de Entorno / Environment Variables
# ==============================================================================
# Copia este archivo a `.env` para habilitar inferencia en vivo con Google AI
# Studio (Interactions API, SDK `google-genai >= 3.6.1`).
#
# NOTA DE PRIVACIDAD:
# - Si dejas GEMINI_API_KEY vacío, MyLeenTo3 opera automáticamente en modo
#   "Calibrated Benchmark / Offline Demo" con resultados reproducibles (SEED=42).
# - También puedes ingresar tu API Key temporalmente desde el modal de la UI
#   (se envía únicamente en memoria vía header `X-Gemini-API-Key` y nunca se
#   almacena en disco ni en logs).

GEMINI_API_KEY=

# Modelo por defecto permitido (google-genai v1 Interactions API):
# Opciones válidas: gemini-4-hydrogen | gemini-4-argon | gemini-3.5-flash-lite
GEMINI_DEFAULT_MODEL=gemini-4-hydrogen

# Nivel de razonamiento por defecto: high | medium | low
GEMINI_DEFAULT_THINKING_LEVEL=high

# Puertos locales para despliegue con Docker Compose / desarrollo
BACKEND_PORT=8000
FRONTEND_PORT=5173
